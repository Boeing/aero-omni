interface omni0
{
        AdvSendAdvert on;
	UnicastOnly on;
	AdvRASolicitedUnicast on;
        MinRtrAdvInterval 3;
        MaxRtrAdvInterval 10;
	AdvManagedFlag on;
	AdvOtherConfigFlag off;
	AdvLinkMTU 65535;
	AdvDefaultLifetime 6000;
        AdvDefaultPreference medium;
	AdvSourceLLAddress on;
        AdvHomeAgentFlag off;
	prefix 2001:db8:1:2::/64
	{
	    AdvOnLink on;
	    AdvAutonomous off;
	    AdvRouterAddr off;
	    AdvValidLifetime 14300;
	    AdvPreferredLifetime 14200;
	};
};
